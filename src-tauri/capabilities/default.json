{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-read-text-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-mkdir",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:scope-appdata-recursive",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME" },
        { "path": "$HOME/**" },
        { "path": "$HOME/**/.*" },
        { "path": "$HOME/**/.*/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DESKTOP/**/.*" },
        { "path": "$DESKTOP/**/.*/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOCUMENT/**/.*" },
        { "path": "$DOCUMENT/**/.*/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOWNLOAD/**/.*" },
        { "path": "$DOWNLOAD/**/.*/**" }
      ]
    }
  ]
}
