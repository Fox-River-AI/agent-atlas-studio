{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Fox-River-AI/agent-atlas/main/registry/schema/system.schema.json",
  "title": "agent-atlas External System manifest",
  "description": "An external system or datastore an agent/tool connects to: a database, vector store, graph/ontology store, FHIR endpoint, or third-party API. Lets the model answer 'what touches this datastore?'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "version", "owner", "systemKind"],
  "properties": {
    "apiVersion": { "const": "agent-atlas/v1" },
    "kind": { "const": "System" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "owner": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "systemKind": {
      "enum": ["relational-db", "vector-store", "graph-db", "document-store", "fhir", "state-store", "external-api", "other"],
      "description": "The class of system, so the data/knowledge layer (RAG vector stores, ontology graph DBs, run-state stores) is legible in the model."
    },
    "connection": { "type": "string", "description": "Connection hint (host/endpoint/DSN), not secrets." },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "scope": { "type": "string" } }
    }
  }
}
