{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Fox-River-AI/agent-atlas/main/registry/schema/job.schema.json",
  "title": "agent-atlas Job manifest",
  "description": "A long-running / asynchronous unit of work (e.g. a Celery task) dispatched to a queue rather than blocking the reasoning loop.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "version", "owner", "queue"],
  "properties": {
    "apiVersion": { "const": "agent-atlas/v1" },
    "kind": { "const": "Job" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "owner": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "queue": { "type": "string", "minLength": 1, "description": "The task queue this job is dispatched to." },
    "trigger": { "type": "string", "description": "What dispatches this job (the id of the tool or agent that enqueues it)." },
    "timeout_seconds": { "type": "integer", "minimum": 1 },
    "retries": { "type": "integer", "minimum": 0 }
  }
}
