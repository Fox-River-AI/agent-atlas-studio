    "conversion-model-router": {
      "id": "conversion-model-router",
      "kind": "router",
      "parent": "mapping-agent",
      "data": {
        "id": "conversion-model-router",
        "owner": "modernization-platform",
        "version": "1.0.0",
        "description": "Select the LLM for mapping/codegen by construct complexity, required quality, latency, and cost.",
        "candidates": [
          {
            "provider": "anthropic",
            "name": "claude-opus-4-8",
            "pinned": "claude-opus-4-8"
          },
          {
            "provider": "anthropic",
            "name": "claude-haiku-4-5",
            "pinned": "claude-haiku-4-5-20251001"
          }
        ],
        "optimizeFor": [
          "quality",
          "cost"
        ],
        "rules": [
          {
            "when": "construct_complexity == high",
            "select": "claude-opus-4-8"
          },
          {
            "when": "simple_1to1_mapping",
            "select": "claude-haiku-4-5"
          }
        ],
        "fallback": "claude-opus-4-8"
      }
    },
